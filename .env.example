APP_NAME=Async Payment Processing
ENVIRONMENT=local
LOG_LEVEL=INFO

API_KEY=change-me

POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_PORT=5434

DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5434/payments

RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

RABBITMQ_URL=amqp://payments:payments@localhost:5673/

OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_POLL_INTERVAL_SECONDS=1.0
RABBIT_PUBLISH_TIMEOUT_SECONDS=5.0

MOCK_PROVIDER_PORT=8001

PAYMENT_PROVIDER_URL=http://localhost:8001
PAYMENT_PROVIDER_REQUEST_TIMEOUT_SECONDS=6
PAYMENT_PROVIDER_MAX_ATTEMPTS=3
PAYMENT_PROVIDER_RETRY_BASE_DELAY_SECONDS=0.2
PAYMENT_PROVIDER_RETRY_MAX_DELAY_SECONDS=1.0
PAYMENT_PROVIDER_RETRY_TOTAL_TIMEOUT_SECONDS=10
